---
/*
  The landing-page signature: teachers pick the SITUATION they're in, in plain
  language, instead of navigating a doc tree. Big tap targets, one icon each
  for fast scanning. Data-driven so it's easy to add a new entry.
*/
type Situation = {
  emoji: string;
  title: string;
  description: string;
  href: string;
};

const situations: Situation[] = [
  {
    emoji: "🔑",
    title: "Jeg kan ikke logge ind",
    description: "Brug din @meddel.dk-konto og se den anbefalede vej ind til Aula og portaler.",
    href: "/login-koder-og-sikker-adgang/den-bedste-made-at-logge-ind-pa/",
  },
  {
    emoji: "👋",
    title: "Jeg er ny medarbejder",
    description: "Find dit brugernavn, lav et kodeord og kom ind på din Chromebook første gang.",
    href: "/chromebook-og-forste-dag/hvordan-kommer-jeg-ind-pa-min-chromebook/",
  },
  {
    emoji: "🔁",
    title: "Jeg skal skifte en kode",
    description: "Elevens Uni-login, elevens Chromebook-kode eller din egen kode.",
    href: "/login-koder-og-sikker-adgang/",
  },
  {
    emoji: "📄",
    title: "Jeg skal dele et dokument",
    description: "Del i Google Drev med personer uden for kommunen eller uden @meddel.dk.",
    href: "/google-drev/hvordan-deler-jeg-dokumenter/",
  },
  {
    emoji: "🎬",
    title: "Jeg skal bruge video",
    description: "Skoletube-kanaler, WeVideo og sådan ser du YouTube via konvertering.",
    href: "/video-medier-og-laeremidler/",
  },
  {
    emoji: "🔗",
    title: "Jeg leder efter et link",
    description: "Genveje til YouTube-konvertering, oversættelse og andre nyttige tjenester.",
    href: "/links-og-genveje/",
  },
];
---

<nav class="edb-situations" aria-label="Hvad skal du bruge hjælp til?">
  {
    situations.map((s) => (
      <a
        class="group flex items-start gap-4 rounded-xl border border-[var(--sl-color-gray-5)] bg-[var(--sl-color-bg-nav)] p-5 no-underline transition-all duration-200 hover:border-[var(--sl-color-accent)] hover:-translate-y-0.5 hover:shadow-md"
        href={s.href}
      >
        <span
          class="grid place-items-center flex-none w-12 h-12 rounded-lg bg-[var(--edb-brand-soft)] text-2xl"
          aria-hidden="true"
        >
          {s.emoji}
        </span>
        <span class="flex flex-col gap-1">
          <span class="text-base font-semibold text-[var(--sl-color-white)] group-hover:text-[var(--sl-color-accent)]">
            {s.title}
          </span>
          <span class="text-sm leading-snug text-[var(--sl-color-gray-3)]">
            {s.description}
          </span>
        </span>
      </a>
    ))
  }
</nav>

<style>
  .edb-situations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
</style>
