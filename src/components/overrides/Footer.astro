---
// Renders Starlight's default footer (pagination, last-updated, edit links)
// and appends a small EDB Pede credit line so every page keeps the identity.
import Default from "@astrojs/starlight/components/Footer.astro";
---

<Default><slot /></Default>

<div class="edb-credit">
  <p>
    Lavet med <span aria-hidden="true">💾</span> af <strong>EDB Pede</strong> –
    skolens IT-hjælp på Strandgårdskolen.
  </p>
  <p class="edb-credit__sub">
    Sidder du fast? Skriv til EDB Pede på Aula, og nævn hvilken guide og hvilket
    trin du er nået til.
  </p>
</div>

<style>
  .edb-credit {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .edb-credit p {
    margin: 0;
  }
  .edb-credit__sub {
    margin-top: 0.35rem;
  }
  .edb-credit strong {
    color: var(--sl-color-white);
  }
</style>
