---
// Wraps Starlight's default PageFrame and adds a desktop-only handle that
// collapses the whole left sidebar for full-width reading. The choice is
// remembered in localStorage and re-applied before paint by the small script
// in `head` (see astro.config.mjs) so the layout never flashes.
import Default from "@astrojs/starlight/components/PageFrame.astro";

const { hasSidebar } = Astro.locals.starlightRoute;
---

<Default>
  <slot name="header" slot="header" />
  <slot name="sidebar" slot="sidebar" />
  <slot />
</Default>

{
  hasSidebar && (
    <button
      class="edb-sidebar-toggle print:hidden"
      type="button"
      aria-expanded="true"
      aria-controls="starlight__sidebar"
      aria-label="Vis eller skjul menuen"
    >
      <svg
        class="edb-sidebar-toggle__icon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <line x1="9" y1="4" x2="9" y2="20" />
      </svg>
    </button>
  )
}

<script>
  // Toggle the whole left sidebar on desktop and remember the choice.
  const KEY = "edb-sidebar-collapsed";
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>(".edb-sidebar-toggle");

  if (btn) {
    // Reflect the current (possibly pre-applied) state in the button.
    btn.setAttribute(
      "aria-expanded",
      String(!root.hasAttribute("data-edb-sidebar-collapsed")),
    );

    btn.addEventListener("click", () => {
      const collapsed = root.toggleAttribute("data-edb-sidebar-collapsed");
      btn.setAttribute("aria-expanded", String(!collapsed));
      try {
        localStorage.setItem(KEY, collapsed ? "1" : "0");
      } catch {
        /* private mode / storage disabled — toggle still works per page */
      }
    });
  }
</script>
